{{ ansible_managed | default('Managed by Ansible.') }}
# Included automatically via sshd_config's default
# "Include /etc/ssh/sshd_config.d/*.conf" directive on Ubuntu - do not
# rename this file to something sorting before other drop-ins you rely on.
{% if hardening_ssh_disable_root_login %}
PermitRootLogin no
{% endif %}
{% if hardening_ssh_disable_password_authentication %}
PasswordAuthentication no
KbdInteractiveAuthentication no
{% endif %}
