# Copy to .env for local docker-compose development.
# These are non-production placeholder values only.

# --- Postgres ---
POSTGRES_DB=taskflow
POSTGRES_USER=taskflow
POSTGRES_PASSWORD=changeme-local-only
POSTGRES_PORT=5432

# --- task-service ---
DATABASE_URL=postgresql+psycopg2://taskflow:changeme-local-only@postgres:5432/taskflow
TASK_SERVICE_PORT=8000
LOG_LEVEL=info

# --- api-gateway ---
API_GATEWAY_PORT=8080
TASK_SERVICE_URL=http://task-service:8000
