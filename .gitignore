# --- Secrets & environment ---
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12
id_rsa*
*credentials*
secrets/
!**/secret.example.yaml

# --- Kubernetes / kubeconfig ---
kubeconfig*
*.kubeconfig

# --- Terraform ---
*.tfstate
*.tfstate.*
*.tfvars
!terraform.tfvars.example
.terraform/
crash.log
crash.*.log
# .terraform.lock.hcl is intentionally NOT ignored: it pins exact provider
# versions and should be committed for reproducible `terraform init` runs.

# --- Ansible ---
*.retry
# Local ansible-galaxy collections cache - created when ansible-lint/
# ansible-galaxy is run with ANSIBLE_HOME defaulting to the cwd (e.g. via
# a container with -v ./ansible:/ansible -w /ansible). Disposable, never
# intentional - see ansible/requirements.yml for the actual pinned
# collection list this cache would otherwise duplicate.
.ansible/
# Real inventory values (a copy of an inventory/**/hosts.yml with your
# actual server address/hostname filled in) - see ansible/inventory/README.md.
# No leading path component on purpose: this needs to match at any depth
# (ansible/inventory/dev/hosts.local.yml, a future ansible/inventory/staging/..., etc).
hosts.local.yml
*.local.yml
# Ansible Vault password files - the encrypted *.yml content Vault
# produces is safe to commit, the password that decrypts it is not.
.vault_pass
*.vault_pass
vault_password*

# --- Node ---
node_modules/
npm-debug.log*
services/**/dist/

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Docker ---
*.pid

# --- IDE / OS ---
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# --- Misc generated ---
*.log
coverage/
.coverage
htmlcov/
dist/
build/
