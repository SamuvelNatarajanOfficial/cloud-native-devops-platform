# --- Secrets & environment ---
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12
id_rsa*
*credentials*
secrets/
!**/secret.example.yaml

# --- Kubernetes / kubeconfig ---
kubeconfig*
*.kubeconfig

# --- Terraform ---
*.tfstate
*.tfstate.*
*.tfvars
!terraform.tfvars.example
.terraform/
crash.log
crash.*.log
# .terraform.lock.hcl is intentionally NOT ignored: it pins exact provider
# versions and should be committed for reproducible `terraform init` runs.

# --- Node ---
node_modules/
npm-debug.log*
services/**/dist/

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Docker ---
*.pid

# --- IDE / OS ---
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# --- Misc generated ---
*.log
coverage/
.coverage
htmlcov/
dist/
build/
